# Copiar a `.env` y completar. El archivo `.env` NO se versiona.
RAUDA_DB_HOST=127.0.0.1
RAUDA_DB_PORT=5432
RAUDA_DB_NAME=rauda_dev
RAUDA_DB_USER=rauda_app
RAUDA_DB_PASSWORD=cambiar-esta-clave

# Puertas: el panel y la app del conductor se separan por cabecera Host
RAUDA_HOST_PANEL=panel.example.com
RAUDA_HOST_CONDUCTOR=conductores.example.com

# Capa extra del conductor: link de la operación (/c/CODIGO)
RAUDA_CODIGO_ENTRADA=cambiar-este-codigo
